<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Visibilità dei pacchetti di Winlator e delle sue fork. Serve solo per questi nomi,
        quindi QUERY_ALL_PACKAGES non è più necessario.
        Se usi un altro fork, aggiungi qui il suo package e anche nella lista
        WINLATOR_PACKAGES in WinlatorLauncher.kt.
    -->
    <queries>
        <package android:name="com.winlator" />
        <package android:name="com.winlator.frost" />
        <package android:name="com.winlator.amod" />
        <package android:name="com.winlator.cmod" />
        <package android:name="com.winlator.glodroid" />
    </queries>

    <!-- Backup disattivato: vedi res/xml/data_extraction_rules.xml. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WinlatorHub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="userLandscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>